# GitHub Personal Access Token usado pelo widget github
GITHUB_TOKEN=seu_github_token

# Token usado pelo widget copilot
COPILOT_TOKEN=seu_copilot_token

# Chave da API do WeatherAPI usada pelo widget weather
WEATHERAPI_KEY=sua_weatherapi_key

# Senha do WebSocket do OBS usada pelo widget obs
YASB_OBS_PASSWORD=seu_obs_websocket_password

# Um ou mais caminhos para wallpapers, separados por ponto e vírgula
# Exemplo:
# YASB_WALLPAPER_PATHS=C:\Users\SeuUsuario\Pictures\Wallpapers;D:\Wallpapers
YASB_WALLPAPER_PATHS=C:\Users\SeuUsuario\Pictures\Wallpapers


# ------------------------------------------------------------
# Voce pode criar seus proprios atalhos para pastas, scripts e caminhos personalizados
# Altere os caminhos abaixo para os caminhos corretos, e use-os nos widgets do YASB (ex: home, file_explorer, etc)
# ------------------------------------------------------------

# Pasta Downloads personalizada (exemplo usado no widget home)
Downloads=C:\Users\SeuUsuario\Downloads

# Pasta Documentos personalizada (exemplo usado no widget home)
Documentos=C:\Users\SeuUsuario\Documents

# Pasta temporária do Windows (exemplo usado no widget home)
TEMP=C:\Users\SeuUsuario\AppData\Local\Temp

# Pasta AppData do Windows (exemplo usado no widget home)
APPDATA=C:\Users\SeuUsuario\AppData\Roaming  
